---
// ブログ記事(詳細)ページ
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 必ず紐付いている White Paper(N:1)
const relatedWhitepaper = await getEntry(post.data.whitepaper);

// Related Blog: 同じコレクションから、この記事以外を新しい順に3件
const allPosts = await getCollection("blog");
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((p) => ({
    href: `/blog/${p.id}/`,
    image: p.data.heroImage,
    title: p.data.title,
    description: p.data.description,
    tags: p.data.tags,
  }));
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <main class="page">
    <header class="article-header">
      <h1>{post.data.title}</h1>
      <p class="article-header__desc">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <ul class="tag-list">
          {post.data.tags.map((tag) => (
            <li><a href={`/blog/tag/${encodeURIComponent(tag)}/`}>{tag}</a></li>
          ))}
        </ul>
      )}
    </header>

    {post.data.heroImage && (
      <div class="article-hero">
        <img src={post.data.heroImage} alt={post.data.title} />
      </div>
    )}

    <article class="article-body">
      <Content />
    </article>

    <!-- 関連White Paper(必須・1件) -->
    <section class="whitepaper-cta">
      <div class="whitepaper-cta__body">
        <span class="whitepaper-cta__label">関連資料</span>
        <h2>{relatedWhitepaper.data.title}</h2>
        <p>{relatedWhitepaper.data.description}</p>
        <a class="button" href={`/whitepaper/${relatedWhitepaper.id}/`}>資料を見る</a>
      </div>
      {relatedWhitepaper.data.image && (
        <div class="whitepaper-cta__image" style={`background-image:url(${relatedWhitepaper.data.image})`}></div>
      )}
    </section>

    <!-- Related Blog -->
    {relatedPosts.length > 0 && (
      <section class="section">
        <h2 class="section__heading">関連記事</h2>
        <CardGrid items={relatedPosts} />
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .page { max-width: var(--max-width); margin: 0 auto; padding: var(--space-l) var(--space-m); }

  .article-header { max-width: 720px; margin: 0 auto var(--space-l); display: flex; flex-direction: column; gap: var(--space-s); }
  .article-header h1 { font-size: 40px; font-weight: 700; line-height: 1.3; }
  .article-header__desc { font-size: 18px; color: var(--color-muted); }

  .tag-list { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; }
  .tag-list a {
    font-size: 12px; font-weight: 500; color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 3px 10px; border-radius: 999px;
  }

  .article-hero { margin-bottom: var(--space-l); }
  .article-hero img { width: 100%; max-height: 480px; object-fit: cover; border-radius: var(--radius-m); }

  .article-body {
    max-width: 720px; margin: 0 auto var(--space-xl);
    font-size: 17px; line-height: 1.8;
    display: flex; flex-direction: column; gap: var(--space-s);
  }
  .article-body :global(h2) { font-size: 24px; font-weight: 700; margin-top: var(--space-s); }
  .article-body :global(img) { border-radius: var(--radius-m); }

  .whitepaper-cta {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-m);
    background: var(--color-accent-soft);
    border-radius: var(--radius-m);
    padding: var(--space-m);
    margin-bottom: var(--space-xl);
  }
  .whitepaper-cta__label { font-size: 12px; font-weight: 600; color: var(--color-accent); }
  .whitepaper-cta__body h2 { font-size: 22px; font-weight: 700; margin: 6px 0; }
  .whitepaper-cta__body p { font-size: 14px; color: var(--color-muted); margin-bottom: var(--space-s); }
  .whitepaper-cta__image { width: 160px; height: 120px; flex-shrink: 0; background-size: cover; background-position: center; border-radius: var(--radius-s); }
  .button {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-accent); color: #fff !important;
    font-size: 14px; font-weight: 600;
    padding: 10px 20px; border-radius: var(--radius-s);
  }

  .section__heading { font-size: 24px; font-weight: 700; margin-bottom: var(--space-m); }

  @media (max-width: 640px) {
    .whitepaper-cta { flex-direction: column; align-items: flex-start; }
    .whitepaper-cta__image { width: 100%; height: 160px; }
  }
</style>
