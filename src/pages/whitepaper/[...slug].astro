---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const papers = await getCollection("whitepaper");
  return papers.map((p) => ({
    params: { slug: p.id },
    props: { paper: p },
  }));
}

const { paper } = Astro.props;
const { Content } = await render(paper);

// この資料を紹介しているブログ記事(N:1の逆引き)
const allPosts = await getCollection("blog");
const linkedPosts = allPosts
  .filter((post) => post.data.whitepaper.id === paper.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    href: `/blog/${post.id}/`,
    image: post.data.heroImage,
    title: post.data.title,
    description: post.data.description,
    tags: post.data.tags,
  }));
---

<BaseLayout title={paper.data.title} description={paper.data.description}>
  <main class="page">
    <header class="header">
      <h1>{paper.data.title}</h1>
      <p class="header__desc">{paper.data.description}</p>
      {paper.data.tags.length > 0 && (
        <ul class="tag-list">
          {paper.data.tags.map((tag) => (
            <li><a href={`/whitepaper/tag/${encodeURIComponent(tag)}/`}>{tag}</a></li>
          ))}
        </ul>
      )}
      <a class="button" href={paper.data.fileUrl} download>資料をダウンロード</a>
    </header>

    {paper.data.image && (
      <div class="hero">
        <img src={paper.data.image} alt={paper.data.title} />
      </div>
    )}

    <article class="body">
      <Content />
    </article>

    {linkedPosts.length > 0 && (
      <section class="section">
        <h2 class="section__heading">この資料を紹介しているブログ記事</h2>
        <CardGrid items={linkedPosts} />
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .page { max-width: var(--max-width); margin: 0 auto; padding: var(--space-l) var(--space-m); }

  .header { max-width: 720px; margin: 0 auto var(--space-l); display: flex; flex-direction: column; gap: var(--space-s); }
  .header h1 { font-size: 36px; font-weight: 700; line-height: 1.3; }
  .header__desc { font-size: 17px; color: var(--color-muted); }

  .tag-list { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; }
  .tag-list a {
    font-size: 12px; font-weight: 500; color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 3px 10px; border-radius: 999px;
  }

  .button {
    align-self: flex-start;
    background: var(--color-accent); color: #fff !important;
    font-size: 14px; font-weight: 600;
    padding: 12px 24px; border-radius: var(--radius-s);
  }

  .hero { margin-bottom: var(--space-l); }
  .hero img { width: 100%; max-height: 420px; object-fit: cover; border-radius: var(--radius-m); }

  .body {
    max-width: 720px; margin: 0 auto var(--space-xl);
    font-size: 17px; line-height: 1.8;
    display: flex; flex-direction: column; gap: var(--space-s);
  }
  .body :global(h2) { font-size: 22px; font-weight: 700; margin-top: var(--space-s); }

  .section__heading { font-size: 24px; font-weight: 700; margin-bottom: var(--space-m); }
</style>
