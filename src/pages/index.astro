---
import BaseLayout from "../layouts/BaseLayout.astro";
import CardGrid from "../components/CardGrid.astro";
import { getCollection } from "astro:content";

const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((post) => ({
    href: `/blog/${post.id}/`,
    image: post.data.heroImage,
    title: post.data.title,
    description: post.data.description,
    tags: post.data.tags,
  }));

const latestPapers = (await getCollection("whitepaper"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((p) => ({
    href: `/whitepaper/${p.id}/`,
    image: p.data.image,
    title: p.data.title,
    description: p.data.description,
    tags: p.data.tags,
  }));
---

<BaseLayout title="Coconeco-log" description="Coconeco-logのトップページです。">
  <main>
    <section class="hero">
      <h1>Coconeco-log</h1>
      <p>ここにサイトのキャッチコピーを書いてください。</p>
      <a class="button" href="/blog/">ブログを見る</a>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>New Article</h2>
        <a class="section__more" href="/blog/">すべて見る</a>
      </div>
      <CardGrid items={latestPosts} emptyText="記事はまだありません。" />
    </section>

    <section class="section">
      <div class="section__head">
        <h2>White Paper</h2>
        <a class="section__more" href="/whitepaper/">すべて見る</a>
      </div>
      <CardGrid items={latestPapers} emptyText="White Paperはまだありません。" />
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    max-width: var(--max-width); margin: 0 auto;
    padding: var(--space-xl) var(--space-m);
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-s);
  }
  .hero h1 { font-size: 40px; font-weight: 700; }
  .hero p { font-size: 17px; color: var(--color-muted); }
  .button {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-accent); color: #fff !important;
    font-size: 14px; font-weight: 600;
    padding: 12px 24px; border-radius: var(--radius-s);
    margin-top: var(--space-xs);
  }

  .section { max-width: var(--max-width); margin: 0 auto; padding: var(--space-l) var(--space-m); }
  .section__head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--space-m); }
  .section__head h2 { font-size: 24px; font-weight: 700; }
  .section__more { font-size: 14px; color: var(--color-accent); font-weight: 500; }
</style>
